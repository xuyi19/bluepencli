# 复制本文件为 .env 后按需修改（.env 已在 .gitignore 中，不会被提交）

APP_NAME=蓝笔申论 BluePencil
APP_VERSION=0.1.0
DEBUG=True

# SQLite 默认落在 backend/data/bluepencil.db，留空即可，无需任何数据库服务
# 若要换成 MySQL：mysql+asyncmy://user:password@127.0.0.1:3306/bluepencil?charset=utf8mb4
# DB_URL=

# 服务端兜底模型配置
# 留空则前端必须在「设置」页自己填 Key。
# 填了则任何人打开页面都能直接用你的额度——公网部署时请务必留空。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 网关行为
LLM_TIMEOUT=180
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=6

# CORS 允许来源，逗号分隔；* 表示全部放行（本地自用默认全放）
CORS_ORIGINS=*
