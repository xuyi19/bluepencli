{
  "$schema": "../../frontend/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "蓝笔申论",
  "version": "0.18.0",
  "identifier": "com.xuyi.bluepencil",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "蓝笔申论",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
