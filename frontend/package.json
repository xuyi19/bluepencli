{
  "name": "bluepencil",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "蓝笔申论 - 申论练习与 AI 批改工具",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:local": "vite build --mode full",
