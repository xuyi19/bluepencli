# 依赖
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# 构建产物（可随时重建）
frontend/dist/
frontend/dist-single/

# 桌面版打包产物（用 backend/build_desktop.py 一键重建）
backend/build/
# release/ 只保留最新一版产物，文件名带版本号（版本取自 CHANGELOG.md）
release/蓝笔申论-桌面版*/
release/*.zip
release/*.html
release/.old-*/

# 本地验证用临时目录（无头浏览器截图 / 烟测产物）
.smoke/
.shots/

# 环境变量
.env
.env.local

# 本地数据库
backend/data/*.db
backend/data/*.db-journal

# 练习归档（运行时产出：每批改一次就新增一对 md+json，文件名带随机 id）
# 内容随 LLM 输出而变，不适合进版本控制；文件本身仍保留在本机 docs/practice/
docs/practice/*.md
docs/practice/*.json

# IDE / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 工作记忆（本机使用，不进版本控制）
.workbuddy/

# 日志
*.log
npm-debug.log*
