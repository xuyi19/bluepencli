# 依赖
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# 构建产物（可随时重建）。
# 用 `dist*/` 而不是逐个列：本机清理目录会撞上批量删除保护，构建前常靠
# "改名挪开"（dist → dist.old-<时间戳>）绕开，用通配才能把这些残留一起挡在库外。
frontend/dist*/

# 私有真题：2022 年起的国考卷（2026-09 分层决定）。
# 这部分是私有资产，由作者定向分发、使用者自行导入，**不进版本库也不进分发产物**。
# 本机由 .tools/exams/to_frontend.py 生成；别人 clone 后不存在，构建自动走
# frontend/src/data/real-exams-private-stub/ 的空实现。
frontend/src/data/real-exams-private/

# 私有卷的**采分点标准**：写出采分点等于泄题，与私有卷正文同等对待。
# 本机由 .tools/standards/gen_standards.mjs 产出；别人 clone 后不存在，
# 构建自动走 frontend/src/data/standards-private-stub/ 的空实现。
frontend/src/data/standards-private/

# 真题流水线的中间产物：out/ 是完整的材料与参考答案（含 2022 起私有卷），
# manual/ 是私有卷的人工补录。两者都由 PDF 重跑生成，不进版本库。
# 只发布流水线脚本本身（extract.py / to_frontend.py / export_bpq.py …）。
.tools/exams/out/
.tools/exams/manual/

# 题库包的**签名私钥**：一旦进库等于把"伪造作者包"的能力公开了。
# 公钥不在这里 —— 公钥写进 frontend/src/bpq/pubkey.js，本来就该公开。
# 由 .tools/exams/bpq-keygen.mjs 生成。
.tools/exams/keys/

# 口令批次表：**存着分发口令原文**，进库等于把私有题库包公开。
# 由 .tools/exams/issue.mjs --new-batch 生成。
.tools/exams/batches.json

# 采分点生成工具的中间产物（含私有卷标准，重跑即复现）
.tools/standards/out/

# 桌面版打包产物（用 backend/build_desktop.py 一键重建）
backend/build/

# release/ 是**本机归档区**，整个目录都不进版本库。
# 里面装的是：分发包（zip / 单文件 HTML）与分发台账 版本说明.md。
#
# ⚠️ 这里必须用整目录规则 `release/` 而不是逐个列 `release/*.zip`：
#    后者匹配不到**子目录**，历史版本归入 release/历史版本/ 之后会集体漏网
#    （2026-09-14 真踩到：git add 差点把 96 MB 产物与私有题库目录一起提交）。
#    目录结构以后还会变，整目录忽略才是稳的。
release/

# 私有题库包（.bpq）：定向分发的私有资产，**绝不能进公开仓库**。
#
# 2026-09-21 从 `release/私有题库/` 挪到项目根，并补上这条显式规则。
# 挪出来的理由：它原先只是**顺带**被 `release/` 整目录规则盖住的 ——
# 一份私密数据混在产物区里，而产物区迟早会有人为了提交某个说明文件
# 去松动那条规则（改成逐个列），那一刻它就静静漏出去了。
# **私密资产的忽略规则必须显式写、且与它的目录绑在一起，不要依赖别人顺带挡住。**
私有题库/

# 本地验证用临时目录（无头浏览器截图 / 烟测产物）
.smoke/
.shots/

# 环境变量
.env
.env.local

# 本地数据库
backend/data/*.db
backend/data/*.db-journal

# 练习归档（运行时产出：每批改一次就新增一对 md+json，文件名带随机 id）
# 内容随 LLM 输出而变，不适合进版本控制；文件本身仍保留在本机 docs/practice/
docs/practice/*.md
docs/practice/*.json

# IDE / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 工作记忆（本机使用，不进版本控制）
.workbuddy/

# 日志
*.log
npm-debug.log*
